# Local dev (next dev loads .env.local).
# Production build uses .env.production (HTTPS API on myadbot.net).
#
# Direct API (typical for Vercel + myadbot nginx — no trailing slash):
#   NEXT_PUBLIC_API_URL=https://myadbot.net/adzz-api
#
# Local backend only:
#   NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_API_URL=https://myadbot.net/adzz-api

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
