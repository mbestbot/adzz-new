# Local dev: next dev loads .env.local (optional).
#
# Recommended (same-origin proxy — matches production, no mixed content):
#   NEXT_PUBLIC_API_URL=/adzz-api-proxy
#   ADZZ_API_UPSTREAM=http://localhost:3001
# Or point proxy at VPS nginx:
#   ADZZ_API_UPSTREAM=http://YOUR_IP/adzz-api
#
# Legacy direct API (no proxy):
#   NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Production / Vercel: NEXT_PUBLIC_API_URL=/adzz-api-proxy in .env.production.
# Set ADZZ_API_UPSTREAM on Vercel if your VPS URL differs from next.config default.

NEXT_PUBLIC_API_URL=/adzz-api-proxy
ADZZ_API_UPSTREAM=http://localhost:3001

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
