# Copy to `.env.local` for local development (Next loads `.env*.local` in dev).
#
# Local UI → local API (default if you omit NEXT_PUBLIC_API_URL in dev — see `lib/api.ts`):
#   NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Production values are baked from `.env.production` at `next build` (HTTPS API host):
#   NEXT_PUBLIC_API_URL=https://api.pearlgrow.com

NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
