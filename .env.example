# Local dev (next dev loads .env.local). Production: .env.production (baked into next build).
# API base URL: no trailing slash. Examples:
#   http://YOUR_VPS_IP/adzz-api
#   https://api.yourdomain.com/adzz-api   (required for Vercel HTTPS -> mixed content rules)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Stripe publishable key (safe in browser) — same mode as backend secret (test vs live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
