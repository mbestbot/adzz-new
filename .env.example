# Local dev (next dev loads .env.local). Production: .env.production → https://myadbot.net/adzz-api
# The browser URL has no port; nginx terminates TLS and proxies to the API process (internal port 8000 on the VPS).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Stripe publishable key (safe in browser) — same mode as backend secret (test vs live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
